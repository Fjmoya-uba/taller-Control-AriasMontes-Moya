%% Identificacion por error de posicion: y'' = K*angulo - p*y' + c
clear; clc; close all;
carpeta = fileparts(mfilename('fullpath'));
archivo = fullfile(carpeta, 'mediciones_dinamica_carrito_1.mat');
S = load(archivo);
t = double(S.out.tout(:));
u = double(S.out.d1(:));             % Angulo del filtro [grados], cero horizontal
y = double(S.out.d2(:)) - 15.612;    % Distancia absoluta -> posicion [cm]
assert(numel(t)==numel(u) && numel(t)==numel(y), 'Longitudes incompatibles.');
assert(all(isfinite(t)) && all(diff(t)>0), 'Tiempo invalido/no creciente.');
% No interpolar ecos invalidos ni unir segmentos separados: usar el tramo
% continuo valido mas largo dentro del registro solicitado.
t_inicio = 0; t_fin = 45;
valido = isfinite(u) & isfinite(y) & y >= -9 & y <= 15 & ...
         t >= t_inicio & t <= t_fin;
bordes = diff([false; valido; false]);
inicios = find(bordes==1); finales = find(bordes==-1)-1;
assert(~isempty(inicios), 'No hay mediciones validas dentro de los limites.');
[~,j] = max(finales-inicios+1); idx = (inicios(j):finales(j))';
fprintf('Archivo: %s\n', archivo);
fprintf('Tramo continuo: filas %d a %d, tiempos %.3f a %.3f s.\n', ...
    idx(1),idx(end),t(idx(1)),t(idx(end)));
if numel(idx)<numel(t)
    fprintf('Se excluyeron %d muestras fuera del tramo continuo seleccionado.\n',numel(t)-numel(idx));
end
t = t(idx); u = u(idx); y = y(idx); t = t-t(1);
N = numel(t); assert(N>=100, 'Tramo demasiado corto: menos de 100 muestras.');
Ts = median(diff(t));
assert(max(abs(diff(t)-Ts)) < 0.1*Ts, 'Hay huecos/jitter significativo en el tiempo.');
fprintf('Ts = %.6f s (%.2f Hz).\n',Ts,1/Ts);
n_est = floor(0.75*N); k_val = (n_est+1:N)';
% Para cada p, la posicion es lineal en [K,c,y_inicial,v_inicial].
% Se ajustan esas cuatro cantidades por minimos cuadrados SOLO en entrenamiento.
% Barrido amplio + refinamiento; p=0 representa el doble integrador.
p_max = 100; % s^-1; si el optimo toca el borde, revisar identificabilidad.
rejilla = [0, logspace(-4,log10(p_max),100)];
costos = arrayfun(@(p) costo(p,t(1:n_est),u(1:n_est),y(1:n_est)),rejilla);
[~,j] = min(costos);
if j>1 && j<numel(rejilla)
    p_ref = fminbnd(@(p) costo(p,t(1:n_est),u(1:n_est),y(1:n_est)), ...
        rejilla(j-1),rejilla(j+1));
else
    p_ref = rejilla(j);
end
candidatos = [0,rejilla(j),p_ref];
[~,j] = min(arrayfun(@(p) costo(p,t(1:n_est),u(1:n_est),y(1:n_est)),candidatos));
p_est = candidatos(j);
[~,coef] = costo(p_est,t(1:n_est),u(1:n_est),y(1:n_est));
K_est = coef(1); sesgo = coef(2); y_inicial = coef(3); v_inicial = coef(4);
y_sim = base_posicion(p_est,t,u)*coef;
% Comparacion: misma estimacion y validacion para el doble integrador.
[~,coef_di] = costo(0,t(1:n_est),u(1:n_est),y(1:n_est));
y_di = base_posicion(0,t,u)*coef_di;
[rmse_val,fit_val] = metricas(y(k_val),y_sim(k_val));
[rmse_di,fit_di] = metricas(y(k_val),y_di(k_val));
fprintf('\nK = %.8g cm/(grado*s^2), p = %.8g s^-1\n',K_est,p_est);
fprintf('c = %.8g cm/s^2, y inicial = %.6g cm, v inicial = %.6g cm/s\n', ...
    sesgo,y_inicial,v_inicial);
fprintf('G(s) = %.8g / [s*(s+%.8g)]\n',K_est,p_est);
fprintf('Validacion: muestras %d a %d; estados propagados sin reinicio.\n',n_est+1,N);
fprintf('Viscoso: RMSE = %.6g cm | FIT = %.2f %%\n',rmse_val,fit_val);
fprintf('Doble integrador: RMSE = %.6g cm | FIT = %.2f %%\n',rmse_di,fit_di);
if p_est>=0.99*p_max
    warning('Polo en el limite de busqueda: no interpretar como parametro fisico confiable.');
end
if K_est<=0
    warning('Ganancia no positiva: revisar signos de angulo/posicion y calidad del ajuste.');
end
% La transferencia no incluye el sesgo ni las condiciones iniciales.
G_carrito = tf(K_est,[1 p_est 0]);
figure('Name','Identificacion del carrito','Color','white');
subplot(3,1,1); plot(t,u); grid on; ylabel('Angulo [grados]');
xline(t(n_est+1),':k','Validacion');
subplot(3,1,2); plot(t,y,t,y_sim,'--',t,y_di,':'); grid on;
ylabel('Posicion [cm]'); legend('Medida','Viscoso','Doble integrador','Location','best');
xline(t(n_est+1),':k');
subplot(3,1,3); plot(t(k_val),y(k_val)-y_sim(k_val)); grid on;
ylabel('Error [cm]'); xlabel('Tiempo desde inicio del tramo [s]');
savefig(fullfile(carpeta,'validacion_dinamica_carrito.fig'));
exportgraphics(gcf,fullfile(carpeta,'validacion_dinamica_carrito.png'));
save(fullfile(carpeta,'dinamica_carrito_estimada.mat'), ...
    'G_carrito','K_est','p_est','sesgo','y_inicial','v_inicial','Ts', ...
    'rmse_val','fit_val','rmse_di','fit_di','archivo','idx','n_est','t','u','y','y_sim','y_di');

function [err,coef] = costo(p,t,u,y)
    H = base_posicion(p,t,u);
    coef = H\y;
    err = mean((H*coef-y).^2);
end

function H = base_posicion(p,t,u)
    % Integracion exacta por intervalo para angulo retenido (ZOH).
    % Bases de respuesta a K y c; se usan tiempos reales, no una grilla inventada.
    n = numel(t); H = zeros(n,4); H(:,3)=1;
    pos = [0 0]; vel = [0 0];
    for k=1:n-1
        h = t(k+1)-t(k); x = p*h;
        if abs(x)<1e-4
            A = h*(1-x/2+x^2/6-x^3/24);
            B = h^2*(1/2-x/6+x^2/24-x^3/120);
        else
            A = -expm1(-x)/p; B = (h-A)/p;
        end
        fuerza = [u(k) 1];
        pos = pos + A*vel + B*fuerza;
        vel = exp(-x)*vel + A*fuerza;
        H(k+1,1:2)=pos;
    end
    if p==0
        H(:,4)=t;
    else
        H(:,4)=-expm1(-p*t)/p;
    end
end

function [rmse,fit] = metricas(y,ys)
    e = y-ys; rmse = sqrt(mean(e.^2)); den = norm(y-mean(y));
    fit = NaN;
    if den>eps, fit=100*(1-norm(e)/den); end
end
