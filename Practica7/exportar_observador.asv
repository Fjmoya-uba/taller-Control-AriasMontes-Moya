function exportar_observador
% Genera los coeficientes del Arduino desde el modelo de esta carpeta.
% Mismo Euler y acker que estimar_theta_punto.m; estados en rad y rad/s.
carpeta = fileparts(mfilename('fullpath'));
S = load('modelo_estimado.mat');
assert(S.G.Ts == 0, 'Se requiere el modelo continuo G.');
[num, den] = tfdata(S.G, 'v');
num = num / den(1); den = den / den(1);
assert(numel(den) == 3 && all(num(1:end-1) == 0), ...
    'G debe ser de segundo orden con numerador constante.');
Ts = 0.02;
Ac = [0 1; -den(3) -den(2)];
A = eye(2) + Ts*Ac;
% G transforma us en grados: convertir su salida a radianes.
B = Ts * [0; num(end)*pi/180];
C = [1 0];

polos_planta = [S.p1 S.p2];

% Por ejemplo, elegís un tiempo de establecimiento más rápido y un zeta menor:
omega_n_obs = 1.7 * max(abs(real(polos_planta))); % Más rápido que la planta
zeta_obs = 0.4; % Amortiguamiento controlado (menor = más ágil/oscilatorio)

% Calculás los polos complejos conjugados deseados en continuo:
p1_cont = -zeta_obs * omega_n_obs + 1j * omega_n_obs * sqrt(1 - zeta_obs^2);
p2_cont = -zeta_obs * omega_n_obs - 1j * omega_n_obs * sqrt(1 - zeta_obs^2);
p_obs_cont = [p1_cont; p2_cont];
display(p_obs_cont);

% Pasás al plano discreto como ya venías haciendo:
p_obs = exp(p_obs_cont * Ts);

p_obs = [0.35 + 0.15j; 0.35 - 0.15j];

L = acker(A', C', p_obs)';
assert(rank(obsv(A,C)) == 2, 'Planta no observable.');
assert(all(abs(eig(A-L*C)) < 1), 'Observador inestable.');
valores = [A(1,1) A(1,2) A(2,1) A(2,2) B(1) B(2) L(1) L(2)];
assert(all(isfinite(valores)), 'Coeficientes no finitos.');
ruta = fullfile(carpeta, 'validar_observador', 'coeficientes_observador.h');
fid = fopen(ruta, 'w');
assert(fid >= 0, 'No se pudo escribir el encabezado.');
limpieza = onCleanup(@() fclose(fid)); %#ok<NASGU>
fprintf(fid, '// Generado por exportar_observador.m. No editar a mano.\n#pragma once\n');
nombres = {'OBS_A11','OBS_A12','OBS_A21','OBS_A22','OBS_B1','OBS_B2','OBS_L1','OBS_L2'};
for i = 1:numel(valores)
    fprintf(fid, 'const float %s = %.9ef;\n', nombres{i}, valores(i));
end
disp('Polos del observador discreto:'); disp(eig(A-L*C));
fprintf('Generado: %s\n', ruta);
end
